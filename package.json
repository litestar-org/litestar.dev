    "happy-dom": "^21.0.4",
    "nuxt-content-twoslash": "^0.4.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "shiki": "^4.6.0",
    "twoslash": "^0.3.9",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
