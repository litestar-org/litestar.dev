    "@nuxt/image": "^2.2.1",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/html-validator": "^2.1.0",
    "@nuxtjs/mdc": "^0.23.2",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@takumi-rs/core": "^2.19.0",
    "@unhead/vue": "^3.4.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue/compiler-sfc": "^3.5.44",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "motion-v": "^2.10.0",
    "nuxt": "^4.6.4",
    "nuxt-ai-ready": "^3.4.0",
    "nuxt-link-checker": "^6.0.1",
    "nuxt-og-image": "^7.0.7",
    "nuxt-schema-org": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "scule": "^1.3.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
